upstream services_backend {
    server BACKEND_HOST_PLACEHOLDER:8084 max_fails=1 fail_timeout=5s;
    server BACKEND_HOST_PLACEHOLDER:8081 backup;
}

server {
    listen 80;
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/ssl/certs/salon-selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/salon-selfsigned.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/salon-belleza;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/v1/appointments {
        proxy_pass http://BACKEND_HOST_PLACEHOLDER:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/v1/services {
        proxy_pass http://services_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/v1/rates {
        proxy_pass http://services_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/v1/clients {
        proxy_pass http://BACKEND_HOST_PLACEHOLDER:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/v1/stylists {
        proxy_pass http://BACKEND_HOST_PLACEHOLDER:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/v1/auth {
        proxy_pass http://BACKEND_HOST_PLACEHOLDER:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/v1/notifications {
        proxy_pass http://BACKEND_HOST_PLACEHOLDER:8083;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://BACKEND_HOST_PLACEHOLDER:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
